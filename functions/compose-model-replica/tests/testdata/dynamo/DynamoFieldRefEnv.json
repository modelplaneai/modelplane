{
  "name": "DynamoFieldRefEnv",
  "reason": "A Dynamo leader's env drawn from a pod field passes through unchanged.",
  "replica": {
    "apiVersion": "modelplane.ai/v1alpha1",
    "kind": "ModelReplica",
    "metadata": {
      "name": "r",
      "namespace": "ml-team"
    },
    "spec": {
      "clusterName": "cluster-a",
      "engines": [
        {
          "copies": 1,
          "members": [
            {
              "deviceRequests": [
                {
                  "count": 8,
                  "deviceClassName": "gpu.nvidia.com",
                  "name": "gpu",
                  "selectors": [
                    {
                      "cel": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                    }
                  ]
                }
              ],
              "nodePoolName": "frontier",
              "role": "Leader",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "command": [
                        "/bin/sh",
                        "-c",
                        "ray start --head --port=6379; exec python3 -m dynamo.vllm --model --model=meta-llama/Llama-3.1-405B --tensor-parallel-size=8 --pipeline-parallel-size=2 --port=8000"
                      ],
                      "env": [
                        {
                          "name": "VLLM_HOST_IP",
                          "valueFrom": {
                            "fieldRef": {
                              "fieldPath": "status.podIP"
                            }
                          }
                        }
                      ],
                      "image": "vllm/vllm-openai:v0.32.0",
                      "name": "engine",
                      "readinessProbe": {
                        "grpc": {
                          "port": 30001
                        },
                        "periodSeconds": 5
                      }
                    }
                  ],
                  "initContainers": [
                    {
                      "name": "runtime",
                      "image": "example/dynamo-sidecar:1.7.0",
                      "command": [
                        "dynamo-vllm-sidecar"
                      ],
                      "args": [
                        "--grpc-endpoint",
                        "127.0.0.1:30001"
                      ],
                      "restartPolicy": "Always"
                    }
                  ]
                }
              }
            },
            {
              "deviceRequests": [
                {
                  "count": 8,
                  "deviceClassName": "gpu.nvidia.com",
                  "name": "gpu",
                  "selectors": [
                    {
                      "cel": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                    }
                  ]
                }
              ],
              "nodePoolName": "frontier",
              "role": "Worker",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "command": [
                        "/bin/sh",
                        "-c",
                        "exec ray start --address=$(MODELPLANE_LEADER_ADDRESS):6379 --block"
                      ],
                      "image": "vllm/vllm-openai:v0.32.0",
                      "name": "engine"
                    }
                  ]
                }
              },
              "worker": {
                "nodes": 1
              }
            }
          ],
          "name": "main"
        }
      ],
      "serving": {
        "mode": "Unified",
        "router": "Dynamo",
        "dynamo": {
          "backendFramework": "vllm",
          "frontend": {
            "replicas": 2,
            "template": {
              "metadata": {
                "labels": {
                  "routing": "user-authored"
                }
              },
              "spec": {
                "containers": [
                  {
                    "name": "main",
                    "image": "example/dynamo-frontend:1.7.0",
                    "command": [
                      "dynamo-frontend"
                    ],
                    "args": [
                      "--router-mode",
                      "round-robin"
                    ],
                    "env": [
                      {
                        "name": "FRONTEND_SETTING",
                        "value": "user-value"
                      }
                    ]
                  }
                ],
                "imagePullSecrets": [
                  {
                    "name": "frontend-registry"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "provider_config": "cluster-a-pc",
  "want": {
    "resource-claim-main-leader": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "SuccessfulCreate"
        },
        "forProvider": {
          "manifest": {
            "apiVersion": "resource.k8s.io/v1",
            "kind": "ResourceClaimTemplate",
            "metadata": {
              "name": "r-main-leader-devices-f58c6",
              "namespace": "mp-ml-team-51733"
            },
            "spec": {
              "spec": {
                "devices": {
                  "requests": [
                    {
                      "name": "gpu",
                      "exactly": {
                        "deviceClassName": "gpu.nvidia.com",
                        "count": 8,
                        "selectors": [
                          {
                            "cel": {
                              "expression": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "resource-claim-main-worker": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "SuccessfulCreate"
        },
        "forProvider": {
          "manifest": {
            "apiVersion": "resource.k8s.io/v1",
            "kind": "ResourceClaimTemplate",
            "metadata": {
              "name": "r-main-worker-devices-99b8a",
              "namespace": "mp-ml-team-51733"
            },
            "spec": {
              "spec": {
                "devices": {
                  "requests": [
                    {
                      "name": "gpu",
                      "exactly": {
                        "deviceClassName": "gpu.nvidia.com",
                        "count": 8,
                        "selectors": [
                          {
                            "cel": {
                              "expression": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "workload-dynamo-1ca5699aff": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "DeriveFromCelQuery",
          "celQuery": "has(object.status) && has(object.status.observedGeneration) && object.status.observedGeneration == object.metadata.generation && has(object.status.conditions) && object.status.conditions.exists(c, c.type == \"Ready\" && c.status == \"True\")"
        },
        "watch": true,
        "forProvider": {
          "manifest": {
            "apiVersion": "nvidia.com/v1beta1",
            "kind": "DynamoGraphDeployment",
            "metadata": {
              "name": "r-1ca5699aff",
              "namespace": "mp-ml-team-51733",
              "annotations": {
                "nvidia.com/grove-update-strategy": "Coherent",
                "nvidia.com/kai-scheduler-queue": "modelplane"
              }
            },
            "spec": {
              "backendFramework": "vllm",
              "components": [
                {
                  "name": "frontend",
                  "type": "frontend",
                  "replicas": 2,
                  "podTemplate": {
                    "metadata": {
                      "labels": {
                        "routing": "user-authored",
                        "modelplane.ai/role": "frontend"
                      }
                    },
                    "spec": {
                      "containers": [
                        {
                          "name": "main",
                          "image": "example/dynamo-frontend:1.7.0",
                          "command": [
                            "dynamo-frontend"
                          ],
                          "args": [
                            "--router-mode",
                            "round-robin"
                          ],
                          "env": [
                            {
                              "name": "FRONTEND_SETTING",
                              "value": "user-value"
                            }
                          ]
                        }
                      ],
                      "imagePullSecrets": [
                        {
                          "name": "frontend-registry"
                        }
                      ]
                    }
                  }
                },
                {
                  "name": "engine-main",
                  "type": "worker",
                  "replicas": 1,
                  "multinode": {
                    "nodeCount": 2
                  },
                  "roles": [
                    {
                      "name": "leader",
                      "replicas": 1,
                      "podTemplate": {
                        "metadata": {
                          "labels": {
                            "modelplane.ai/engine": "main",
                            "modelplane.ai/role": "Leader"
                          }
                        },
                        "spec": {
                          "containers": [
                            {
                              "command": [
                                "/bin/sh",
                                "-c",
                                "ray start --head --port=6379; exec python3 -m dynamo.vllm --model --model=meta-llama/Llama-3.1-405B --tensor-parallel-size=8 --pipeline-parallel-size=2 --port=8000"
                              ],
                              "env": [
                                {
                                  "name": "MODELPLANE_LEADER_ADDRESS",
                                  "value": "$(DYNAMO_LEADER_ADDRESS)"
                                },
                                {
                                  "name": "MODELPLANE_RANK",
                                  "value": "$(DYNAMO_RANK)"
                                },
                                {
                                  "name": "VLLM_HOST_IP",
                                  "valueFrom": {
                                    "fieldRef": {
                                      "fieldPath": "status.podIP"
                                    }
                                  }
                                }
                              ],
                              "image": "vllm/vllm-openai:v0.32.0",
                              "name": "main",
                              "readinessProbe": {
                                "grpc": {
                                  "port": 30001
                                },
                                "periodSeconds": 5
                              },
                              "resources": {
                                "claims": [
                                  {
                                    "name": "devices"
                                  }
                                ]
                              },
                              "volumeMounts": [
                                {
                                  "name": "dshm",
                                  "mountPath": "/dev/shm"
                                }
                              ]
                            }
                          ],
                          "volumes": [
                            {
                              "name": "dshm",
                              "emptyDir": {
                                "medium": "Memory"
                              }
                            }
                          ],
                          "schedulerName": "kai-scheduler",
                          "nodeSelector": {
                            "modelplane.ai/pool": "frontier"
                          },
                          "resourceClaims": [
                            {
                              "name": "devices",
                              "resourceClaimTemplateName": "r-main-leader-devices-f58c6"
                            }
                          ],
                          "tolerations": [
                            {
                              "key": "nvidia.com/gpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            },
                            {
                              "key": "amd.com/gpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            },
                            {
                              "key": "modelplane.ai/cpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            }
                          ],
                          "initContainers": [
                            {
                              "name": "runtime",
                              "image": "example/dynamo-sidecar:1.7.0",
                              "command": [
                                "dynamo-vllm-sidecar"
                              ],
                              "args": [
                                "--grpc-endpoint",
                                "127.0.0.1:30001"
                              ],
                              "restartPolicy": "Always"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "name": "worker",
                      "replicas": 1,
                      "podTemplate": {
                        "metadata": {
                          "labels": {
                            "modelplane.ai/engine": "main",
                            "modelplane.ai/role": "Worker"
                          }
                        },
                        "spec": {
                          "containers": [
                            {
                              "command": [
                                "/bin/sh",
                                "-c",
                                "exec ray start --address=$(MODELPLANE_LEADER_ADDRESS):6379 --block"
                              ],
                              "image": "vllm/vllm-openai:v0.32.0",
                              "name": "main",
                              "resources": {
                                "claims": [
                                  {
                                    "name": "devices"
                                  }
                                ]
                              },
                              "volumeMounts": [
                                {
                                  "name": "dshm",
                                  "mountPath": "/dev/shm"
                                }
                              ],
                              "env": [
                                {
                                  "name": "MODELPLANE_LEADER_ADDRESS",
                                  "value": "$(DYNAMO_LEADER_ADDRESS)"
                                },
                                {
                                  "name": "MODELPLANE_RANK",
                                  "value": "$(DYNAMO_RANK)"
                                }
                              ]
                            }
                          ],
                          "volumes": [
                            {
                              "name": "dshm",
                              "emptyDir": {
                                "medium": "Memory"
                              }
                            }
                          ],
                          "schedulerName": "kai-scheduler",
                          "nodeSelector": {
                            "modelplane.ai/pool": "frontier"
                          },
                          "resourceClaims": [
                            {
                              "name": "devices",
                              "resourceClaimTemplateName": "r-main-worker-devices-99b8a"
                            }
                          ],
                          "tolerations": [
                            {
                              "key": "nvidia.com/gpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            },
                            {
                              "key": "amd.com/gpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            },
                            {
                              "key": "modelplane.ai/cpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  "validation": null
}
