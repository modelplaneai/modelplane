{
  "name": "ArgsOnlyNativeEngine",
  "reason": "An args-only native template preserves the image entrypoint and arguments.",
  "replica": {
    "apiVersion": "modelplane.ai/v1alpha1",
    "kind": "ModelReplica",
    "metadata": {
      "name": "r",
      "namespace": "ml-team"
    },
    "spec": {
      "clusterName": "cluster-a",
      "engines": [
        {
          "name": "main",
          "copies": 3,
          "members": [
            {
              "role": "Standalone",
              "nodePoolName": "frontier",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "name": "engine",
                      "image": "vllm/vllm-openai:v0.32.0",
                      "args": [
                        "--model",
                        "Qwen/Qwen3-0.6B"
                      ],
                      "readinessProbe": {
                        "grpc": {
                          "port": 30001
                        },
                        "periodSeconds": 5
                      }
                    },
                    {
                      "name": "logging",
                      "image": "example/logger:1",
                      "args": [
                        "--stdout"
                      ]
                    }
                  ],
                  "initContainers": [
                    {
                      "name": "runtime",
                      "image": "example/dynamo-sidecar:1.7.0",
                      "command": [
                        "dynamo-vllm-sidecar"
                      ],
                      "args": [
                        "--grpc-endpoint",
                        "127.0.0.1:30001"
                      ],
                      "restartPolicy": "Always"
                    }
                  ]
                }
              },
              "deviceRequests": [
                {
                  "name": "gpu",
                  "deviceClassName": "gpu.nvidia.com",
                  "count": 1
                }
              ]
            }
          ]
        }
      ],
      "serving": {
        "mode": "Unified",
        "router": "Dynamo",
        "dynamo": {
          "backendFramework": "vllm",
          "frontend": {
            "replicas": 2,
            "template": {
              "metadata": {
                "labels": {
                  "routing": "user-authored"
                }
              },
              "spec": {
                "containers": [
                  {
                    "name": "main",
                    "image": "example/dynamo-frontend:1.7.0",
                    "command": [
                      "dynamo-frontend"
                    ],
                    "args": [
                      "--router-mode",
                      "round-robin"
                    ],
                    "env": [
                      {
                        "name": "FRONTEND_SETTING",
                        "value": "user-value"
                      }
                    ]
                  }
                ],
                "imagePullSecrets": [
                  {
                    "name": "frontend-registry"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "provider_config": "cluster-a-pc",
  "want": {
    "resource-claim-main-standalone": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "SuccessfulCreate"
        },
        "forProvider": {
          "manifest": {
            "apiVersion": "resource.k8s.io/v1",
            "kind": "ResourceClaimTemplate",
            "metadata": {
              "name": "r-main-standalone-devices-f456f",
              "namespace": "mp-ml-team-51733"
            },
            "spec": {
              "spec": {
                "devices": {
                  "requests": [
                    {
                      "name": "gpu",
                      "exactly": {
                        "deviceClassName": "gpu.nvidia.com",
                        "count": 1
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "workload-dynamo-5e03f93660": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "DeriveFromCelQuery",
          "celQuery": "has(object.status) && has(object.status.observedGeneration) && object.status.observedGeneration == object.metadata.generation && has(object.status.conditions) && object.status.conditions.exists(c, c.type == \"Ready\" && c.status == \"True\")"
        },
        "watch": true,
        "forProvider": {
          "manifest": {
            "apiVersion": "nvidia.com/v1beta1",
            "kind": "DynamoGraphDeployment",
            "metadata": {
              "name": "r-5e03f93660",
              "namespace": "mp-ml-team-51733",
              "annotations": {
                "nvidia.com/grove-update-strategy": "Coherent",
                "nvidia.com/kai-scheduler-queue": "modelplane"
              }
            },
            "spec": {
              "backendFramework": "vllm",
              "components": [
                {
                  "name": "frontend",
                  "type": "frontend",
                  "replicas": 2,
                  "podTemplate": {
                    "metadata": {
                      "labels": {
                        "routing": "user-authored",
                        "modelplane.ai/role": "frontend"
                      }
                    },
                    "spec": {
                      "containers": [
                        {
                          "name": "main",
                          "image": "example/dynamo-frontend:1.7.0",
                          "command": [
                            "dynamo-frontend"
                          ],
                          "args": [
                            "--router-mode",
                            "round-robin"
                          ],
                          "env": [
                            {
                              "name": "FRONTEND_SETTING",
                              "value": "user-value"
                            }
                          ]
                        }
                      ],
                      "imagePullSecrets": [
                        {
                          "name": "frontend-registry"
                        }
                      ]
                    }
                  }
                },
                {
                  "name": "engine-main",
                  "type": "worker",
                  "replicas": 3,
                  "podTemplate": {
                    "metadata": {
                      "labels": {
                        "modelplane.ai/engine": "main",
                        "modelplane.ai/role": "Standalone"
                      }
                    },
                    "spec": {
                      "containers": [
                        {
                          "name": "main",
                          "image": "vllm/vllm-openai:v0.32.0",
                          "args": [
                            "--model",
                            "Qwen/Qwen3-0.6B"
                          ],
                          "readinessProbe": {
                            "grpc": {
                              "port": 30001
                            },
                            "periodSeconds": 5
                          },
                          "resources": {
                            "claims": [
                              {
                                "name": "devices"
                              }
                            ]
                          },
                          "volumeMounts": [
                            {
                              "name": "dshm",
                              "mountPath": "/dev/shm"
                            }
                          ],
                          "env": []
                        },
                        {
                          "name": "logging",
                          "image": "example/logger:1",
                          "args": [
                            "--stdout"
                          ]
                        }
                      ],
                      "volumes": [
                        {
                          "name": "dshm",
                          "emptyDir": {
                            "medium": "Memory"
                          }
                        }
                      ],
                      "schedulerName": "kai-scheduler",
                      "nodeSelector": {
                        "modelplane.ai/pool": "frontier"
                      },
                      "tolerations": [
                        {
                          "key": "nvidia.com/gpu",
                          "operator": "Exists",
                          "effect": "NoSchedule"
                        },
                        {
                          "key": "amd.com/gpu",
                          "operator": "Exists",
                          "effect": "NoSchedule"
                        },
                        {
                          "key": "modelplane.ai/cpu",
                          "operator": "Exists",
                          "effect": "NoSchedule"
                        }
                      ],
                      "resourceClaims": [
                        {
                          "name": "devices",
                          "resourceClaimTemplateName": "r-main-standalone-devices-f456f"
                        }
                      ],
                      "initContainers": [
                        {
                          "name": "runtime",
                          "image": "example/dynamo-sidecar:1.7.0",
                          "command": [
                            "dynamo-vllm-sidecar"
                          ],
                          "args": [
                            "--grpc-endpoint",
                            "127.0.0.1:30001"
                          ],
                          "restartPolicy": "Always"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "validation": null
}
