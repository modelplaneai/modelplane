{
  "name": "PrefillDecode",
  "reason": "All engine copies share one runtime frontend, retaining application sidecars and phase identity.",
  "replica": {
    "apiVersion": "modelplane.ai/v1alpha1",
    "kind": "ModelReplica",
    "metadata": {
      "name": "r",
      "namespace": "ml-team"
    },
    "spec": {
      "clusterName": "cluster-a",
      "engines": [
        {
          "name": "prefill",
          "copies": 1,
          "members": [
            {
              "role": "Standalone",
              "nodePoolName": "frontier",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "name": "engine",
                      "image": "nvcr.io/nvidia/ai-dynamo/vllm-runtime-nightly:20261103-e37f0b9",
                      "command": [
                        "python3",
                        "-m",
                        "dynamo.vllm"
                      ],
                      "args": [
                        "--model",
                        "Qwen/Qwen3-0.6B",
                        "--disaggregation-mode",
                        "prefill",
                        "--kv-transfer-config",
                        "{\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\"}"
                      ]
                    },
                    {
                      "name": "logging",
                      "image": "example/logger:1",
                      "args": [
                        "--stdout"
                      ]
                    }
                  ]
                }
              },
              "deviceRequests": [
                {
                  "name": "gpu",
                  "deviceClassName": "gpu.nvidia.com",
                  "count": 1
                }
              ]
            }
          ],
          "phase": "Prefill"
        },
        {
          "name": "decode",
          "copies": 2,
          "members": [
            {
              "role": "Standalone",
              "nodePoolName": "frontier",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "name": "engine",
                      "image": "nvcr.io/nvidia/ai-dynamo/vllm-runtime-nightly:20261103-e37f0b9",
                      "command": [
                        "python3",
                        "-m",
                        "dynamo.vllm"
                      ],
                      "args": [
                        "--model",
                        "Qwen/Qwen3-0.6B",
                        "--disaggregation-mode",
                        "decode",
                        "--kv-transfer-config",
                        "{\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\"}"
                      ]
                    },
                    {
                      "name": "logging",
                      "image": "example/logger:1",
                      "args": [
                        "--stdout"
                      ]
                    }
                  ]
                }
              },
              "deviceRequests": [
                {
                  "name": "gpu",
                  "deviceClassName": "gpu.nvidia.com",
                  "count": 1
                }
              ]
            }
          ],
          "phase": "Decode"
        }
      ],
      "serving": {
        "mode": "PrefillDecode"
      }
    }
  },
  "provider_config": "cluster-a-pc",
  "want": {
    "workload-dynamo": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "DeriveFromCelQuery",
          "celQuery": "has(object.status) && has(object.status.observedGeneration) && object.status.observedGeneration == object.metadata.generation && has(object.status.conditions) && object.status.conditions.exists(c, c.type == \"Ready\" && c.status == \"True\")"
        },
        "watch": true,
        "forProvider": {
          "manifest": {
            "apiVersion": "nvidia.com/v1beta1",
            "kind": "DynamoGraphDeployment",
            "metadata": {
              "name": "r",
              "namespace": "mp-ml-team-51733"
            },
            "spec": {
              "backendFramework": "vllm",
              "components": [
                {
                  "name": "frontend",
                  "type": "frontend",
                  "replicas": 1,
                  "podTemplate": {
                    "metadata": {
                      "labels": {
                        "modelplane.ai/serving": "r",
                        "modelplane.ai/replica": "r",
                        "modelplane.ai/deployment": "r"
                      }
                    },
                    "spec": {
                      "containers": [
                        {
                          "name": "main",
                          "image": "nvcr.io/nvidia/ai-dynamo/vllm-runtime-nightly:20261103-e37f0b9",
                          "command": [
                            "python3",
                            "-m",
                            "dynamo.frontend"
                          ],
                          "args": [
                            "--http-port",
                            "8000",
                            "--router-mode",
                            "kv"
                          ],
                          "env": [],
                          "volumeMounts": []
                        }
                      ],
                      "volumes": []
                    }
                  },
                  "runtimeVersionOverride": "1.7.0"
                },
                {
                  "name": "engine-prefill",
                  "type": "prefill",
                  "replicas": 1,
                  "podTemplate": {
                    "metadata": {
                      "labels": {
                        "modelplane.ai/engine": "prefill",
                        "modelplane.ai/role": "Standalone",
                        "kai.scheduler/queue": "modelplane",
                        "modelplane.ai/phase": "Prefill"
                      }
                    },
                    "spec": {
                      "containers": [
                        {
                          "name": "main",
                          "image": "nvcr.io/nvidia/ai-dynamo/vllm-runtime-nightly:20261103-e37f0b9",
                          "command": [
                            "python3",
                            "-m",
                            "dynamo.vllm"
                          ],
                          "args": [
                            "--model",
                            "Qwen/Qwen3-0.6B",
                            "--disaggregation-mode",
                            "prefill",
                            "--kv-transfer-config",
                            "{\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\"}"
                          ],
                          "volumeMounts": [],
                          "env": [],
                          "resources": {
                            "claims": [
                              {
                                "name": "devices"
                              }
                            ]
                          }
                        },
                        {
                          "name": "logging",
                          "image": "example/logger:1",
                          "args": [
                            "--stdout"
                          ]
                        }
                      ],
                      "volumes": [],
                      "schedulerName": "kai-scheduler",
                      "nodeSelector": {
                        "modelplane.ai/pool": "frontier"
                      },
                      "tolerations": [
                        {
                          "key": "nvidia.com/gpu",
                          "operator": "Exists",
                          "effect": "NoSchedule"
                        },
                        {
                          "key": "amd.com/gpu",
                          "operator": "Exists",
                          "effect": "NoSchedule"
                        },
                        {
                          "key": "modelplane.ai/cpu",
                          "operator": "Exists",
                          "effect": "NoSchedule"
                        }
                      ],
                      "resourceClaims": [
                        {
                          "name": "devices",
                          "resourceClaimTemplateName": "r-prefill-standalone-devices-f62af"
                        }
                      ]
                    }
                  },
                  "runtimeVersionOverride": "1.7.0"
                },
                {
                  "name": "engine-decode",
                  "type": "decode",
                  "replicas": 2,
                  "podTemplate": {
                    "metadata": {
                      "labels": {
                        "modelplane.ai/engine": "decode",
                        "modelplane.ai/role": "Standalone",
                        "kai.scheduler/queue": "modelplane",
                        "modelplane.ai/phase": "Decode"
                      }
                    },
                    "spec": {
                      "containers": [
                        {
                          "name": "main",
                          "image": "nvcr.io/nvidia/ai-dynamo/vllm-runtime-nightly:20261103-e37f0b9",
                          "command": [
                            "python3",
                            "-m",
                            "dynamo.vllm"
                          ],
                          "args": [
                            "--model",
                            "Qwen/Qwen3-0.6B",
                            "--disaggregation-mode",
                            "decode",
                            "--kv-transfer-config",
                            "{\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\"}"
                          ],
                          "volumeMounts": [],
                          "env": [],
                          "resources": {
                            "claims": [
                              {
                                "name": "devices"
                              }
                            ]
                          }
                        },
                        {
                          "name": "logging",
                          "image": "example/logger:1",
                          "args": [
                            "--stdout"
                          ]
                        }
                      ],
                      "volumes": [],
                      "schedulerName": "kai-scheduler",
                      "nodeSelector": {
                        "modelplane.ai/pool": "frontier"
                      },
                      "tolerations": [
                        {
                          "key": "nvidia.com/gpu",
                          "operator": "Exists",
                          "effect": "NoSchedule"
                        },
                        {
                          "key": "amd.com/gpu",
                          "operator": "Exists",
                          "effect": "NoSchedule"
                        },
                        {
                          "key": "modelplane.ai/cpu",
                          "operator": "Exists",
                          "effect": "NoSchedule"
                        }
                      ],
                      "resourceClaims": [
                        {
                          "name": "devices",
                          "resourceClaimTemplateName": "r-decode-standalone-devices-63392"
                        }
                      ]
                    }
                  },
                  "runtimeVersionOverride": "1.7.0"
                }
              ]
            }
          }
        }
      }
    },
    "resource-claim-prefill-standalone": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "SuccessfulCreate"
        },
        "forProvider": {
          "manifest": {
            "apiVersion": "resource.k8s.io/v1",
            "kind": "ResourceClaimTemplate",
            "metadata": {
              "name": "r-prefill-standalone-devices-f62af",
              "namespace": "mp-ml-team-51733"
            },
            "spec": {
              "spec": {
                "devices": {
                  "requests": [
                    {
                      "name": "gpu",
                      "exactly": {
                        "deviceClassName": "gpu.nvidia.com",
                        "count": 1
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "resource-claim-decode-standalone": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "SuccessfulCreate"
        },
        "forProvider": {
          "manifest": {
            "apiVersion": "resource.k8s.io/v1",
            "kind": "ResourceClaimTemplate",
            "metadata": {
              "name": "r-decode-standalone-devices-63392",
              "namespace": "mp-ml-team-51733"
            },
            "spec": {
              "spec": {
                "devices": {
                  "requests": [
                    {
                      "name": "gpu",
                      "exactly": {
                        "deviceClassName": "gpu.nvidia.com",
                        "count": 1
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "validation": null
}
