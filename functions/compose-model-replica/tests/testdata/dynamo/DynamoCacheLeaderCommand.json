{
  "name": "DynamoCacheLeaderCommand",
  "reason": "A cached Dynamo gang whose leader has its own command mounts the cache, keeping the command verbatim with no --model injected.",
  "replica": {
    "apiVersion": "modelplane.ai/v1alpha1",
    "kind": "ModelReplica",
    "metadata": {
      "name": "r",
      "namespace": "ml-team"
    },
    "spec": {
      "clusterName": "cluster-a",
      "engines": [
        {
          "copies": 1,
          "members": [
            {
              "deviceRequests": [
                {
                  "count": 8,
                  "deviceClassName": "gpu.nvidia.com",
                  "name": "gpu",
                  "selectors": [
                    {
                      "cel": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                    }
                  ]
                }
              ],
              "nodePoolName": "frontier",
              "role": "Leader",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "command": [
                        "/bin/sh",
                        "-c",
                        "python3 -m dynamo.sglang --model-path /mnt/models --tp 16"
                      ],
                      "image": "nvcr.io/nvidia/ai-dynamo/sglang-runtime-nightly:20261103-e37f0b9",
                      "name": "engine"
                    }
                  ]
                }
              }
            },
            {
              "deviceRequests": [
                {
                  "count": 8,
                  "deviceClassName": "gpu.nvidia.com",
                  "name": "gpu",
                  "selectors": [
                    {
                      "cel": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                    }
                  ]
                }
              ],
              "nodePoolName": "frontier",
              "role": "Worker",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "command": [
                        "/bin/sh",
                        "-c",
                        "join"
                      ],
                      "image": "nvcr.io/nvidia/ai-dynamo/sglang-runtime-nightly:20261103-e37f0b9",
                      "name": "engine"
                    }
                  ]
                }
              },
              "worker": {
                "nodes": 1
              }
            }
          ],
          "name": "main"
        }
      ],
      "modelCacheRef": {
        "name": "kimi"
      }
    }
  },
  "provider_config": "cluster-a-pc",
  "want": {
    "resource-claim-main-leader": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "SuccessfulCreate"
        },
        "forProvider": {
          "manifest": {
            "apiVersion": "resource.k8s.io/v1",
            "kind": "ResourceClaimTemplate",
            "metadata": {
              "name": "r-main-leader-devices-f58c6",
              "namespace": "mp-ml-team-51733"
            },
            "spec": {
              "spec": {
                "devices": {
                  "requests": [
                    {
                      "name": "gpu",
                      "exactly": {
                        "deviceClassName": "gpu.nvidia.com",
                        "count": 8,
                        "selectors": [
                          {
                            "cel": {
                              "expression": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "resource-claim-main-worker": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "SuccessfulCreate"
        },
        "forProvider": {
          "manifest": {
            "apiVersion": "resource.k8s.io/v1",
            "kind": "ResourceClaimTemplate",
            "metadata": {
              "name": "r-main-worker-devices-99b8a",
              "namespace": "mp-ml-team-51733"
            },
            "spec": {
              "spec": {
                "devices": {
                  "requests": [
                    {
                      "name": "gpu",
                      "exactly": {
                        "deviceClassName": "gpu.nvidia.com",
                        "count": 8,
                        "selectors": [
                          {
                            "cel": {
                              "expression": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "workload-dynamo-b5624d4c4a": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "DeriveFromCelQuery",
          "celQuery": "has(object.status) && has(object.status.observedGeneration) && object.status.observedGeneration == object.metadata.generation && has(object.status.conditions) && object.status.conditions.exists(c, c.type == \"Ready\" && c.status == \"True\")"
        },
        "watch": true,
        "forProvider": {
          "manifest": {
            "apiVersion": "nvidia.com/v1beta1",
            "kind": "DynamoGraphDeployment",
            "metadata": {
              "name": "r-b5624d4c4a",
              "namespace": "mp-ml-team-51733"
            },
            "spec": {
              "backendFramework": "sglang",
              "components": [
                {
                  "name": "frontend",
                  "type": "frontend",
                  "replicas": 1,
                  "podTemplate": {
                    "metadata": {
                      "labels": {
                        "modelplane.ai/serving": "r",
                        "modelplane.ai/replica": "r",
                        "modelplane.ai/deployment": "r"
                      }
                    },
                    "spec": {
                      "containers": [
                        {
                          "name": "main",
                          "image": "nvcr.io/nvidia/ai-dynamo/sglang-runtime-nightly:20261103-e37f0b9",
                          "command": [
                            "python3",
                            "-m",
                            "dynamo.frontend"
                          ],
                          "args": [
                            "--http-port",
                            "8000",
                            "--router-mode",
                            "kv"
                          ],
                          "env": [
                            {
                              "name": "HF_HUB_CACHE",
                              "value": "/mnt/models"
                            }
                          ],
                          "volumeMounts": [
                            {
                              "name": "model-cache",
                              "mountPath": "/mnt/models"
                            }
                          ]
                        }
                      ],
                      "volumes": [
                        {
                          "name": "model-cache",
                          "persistentVolumeClaim": {
                            "claimName": "modelcache-ml-team-kimi-aa322"
                          }
                        }
                      ]
                    }
                  },
                  "runtimeVersionOverride": "1.7.0"
                },
                {
                  "name": "engine-main",
                  "type": "worker",
                  "replicas": 1,
                  "multinode": {
                    "nodeCount": 2
                  },
                  "roles": [
                    {
                      "name": "leader",
                      "replicas": 1,
                      "podTemplate": {
                        "metadata": {
                          "labels": {
                            "modelplane.ai/engine": "main",
                            "modelplane.ai/role": "Leader",
                            "kai.scheduler/queue": "modelplane"
                          }
                        },
                        "spec": {
                          "containers": [
                            {
                              "name": "main",
                              "image": "nvcr.io/nvidia/ai-dynamo/sglang-runtime-nightly:20261103-e37f0b9",
                              "volumeMounts": [
                                {
                                  "name": "model-cache",
                                  "mountPath": "/mnt/models"
                                }
                              ],
                              "resources": {
                                "claims": [
                                  {
                                    "name": "devices"
                                  }
                                ]
                              },
                              "command": [
                                "/bin/sh",
                                "-c",
                                "python3 -m dynamo.sglang --model-path /mnt/models --tp 16"
                              ],
                              "env": [
                                {
                                  "name": "MODELPLANE_LEADER_ADDRESS",
                                  "value": "$(DYNAMO_LEADER_ADDRESS)"
                                },
                                {
                                  "name": "MODELPLANE_RANK",
                                  "value": "$(DYNAMO_RANK)"
                                },
                                {
                                  "name": "HF_HUB_CACHE",
                                  "value": "/mnt/models"
                                },
                                {
                                  "name": "MX_SERVER_ADDRESS",
                                  "value": "modelexpress-server.default.svc:8001"
                                },
                                {
                                  "name": "MODEL_EXPRESS_URL",
                                  "value": "modelexpress-server.default.svc:8001"
                                },
                                {
                                  "name": "MX_MODEL_REVISION",
                                  "value": "modelcache-ml-team-kimi-aa322"
                                },
                                {
                                  "name": "MX_P2P_METADATA",
                                  "value": "1"
                                },
                                {
                                  "name": "POD_NAME",
                                  "valueFrom": {
                                    "fieldRef": {
                                      "fieldPath": "metadata.name"
                                    }
                                  }
                                },
                                {
                                  "name": "POD_UID",
                                  "valueFrom": {
                                    "fieldRef": {
                                      "fieldPath": "metadata.uid"
                                    }
                                  }
                                },
                                {
                                  "name": "POD_NAMESPACE",
                                  "valueFrom": {
                                    "fieldRef": {
                                      "fieldPath": "metadata.namespace"
                                    }
                                  }
                                }
                              ],
                              "securityContext": {
                                "capabilities": {
                                  "add": [
                                    "IPC_LOCK"
                                  ]
                                }
                              }
                            }
                          ],
                          "volumes": [
                            {
                              "name": "model-cache",
                              "persistentVolumeClaim": {
                                "claimName": "modelcache-ml-team-kimi-aa322"
                              }
                            }
                          ],
                          "schedulerName": "kai-scheduler",
                          "nodeSelector": {
                            "modelplane.ai/pool": "frontier"
                          },
                          "resourceClaims": [
                            {
                              "name": "devices",
                              "resourceClaimTemplateName": "r-main-leader-devices-f58c6"
                            }
                          ],
                          "tolerations": [
                            {
                              "key": "nvidia.com/gpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            },
                            {
                              "key": "amd.com/gpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            },
                            {
                              "key": "modelplane.ai/cpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "name": "worker",
                      "replicas": 1,
                      "podTemplate": {
                        "metadata": {
                          "labels": {
                            "modelplane.ai/engine": "main",
                            "modelplane.ai/role": "Worker",
                            "kai.scheduler/queue": "modelplane"
                          }
                        },
                        "spec": {
                          "containers": [
                            {
                              "name": "main",
                              "image": "nvcr.io/nvidia/ai-dynamo/sglang-runtime-nightly:20261103-e37f0b9",
                              "volumeMounts": [
                                {
                                  "name": "model-cache",
                                  "mountPath": "/mnt/models"
                                }
                              ],
                              "resources": {
                                "claims": [
                                  {
                                    "name": "devices"
                                  }
                                ]
                              },
                              "command": [
                                "/bin/sh",
                                "-c",
                                "join"
                              ],
                              "env": [
                                {
                                  "name": "MODELPLANE_LEADER_ADDRESS",
                                  "value": "$(DYNAMO_LEADER_ADDRESS)"
                                },
                                {
                                  "name": "MODELPLANE_RANK",
                                  "value": "$(DYNAMO_RANK)"
                                },
                                {
                                  "name": "HF_HUB_CACHE",
                                  "value": "/mnt/models"
                                },
                                {
                                  "name": "MX_SERVER_ADDRESS",
                                  "value": "modelexpress-server.default.svc:8001"
                                },
                                {
                                  "name": "MODEL_EXPRESS_URL",
                                  "value": "modelexpress-server.default.svc:8001"
                                },
                                {
                                  "name": "MX_MODEL_REVISION",
                                  "value": "modelcache-ml-team-kimi-aa322"
                                },
                                {
                                  "name": "MX_P2P_METADATA",
                                  "value": "1"
                                },
                                {
                                  "name": "POD_NAME",
                                  "valueFrom": {
                                    "fieldRef": {
                                      "fieldPath": "metadata.name"
                                    }
                                  }
                                },
                                {
                                  "name": "POD_UID",
                                  "valueFrom": {
                                    "fieldRef": {
                                      "fieldPath": "metadata.uid"
                                    }
                                  }
                                },
                                {
                                  "name": "POD_NAMESPACE",
                                  "valueFrom": {
                                    "fieldRef": {
                                      "fieldPath": "metadata.namespace"
                                    }
                                  }
                                }
                              ],
                              "securityContext": {
                                "capabilities": {
                                  "add": [
                                    "IPC_LOCK"
                                  ]
                                }
                              }
                            }
                          ],
                          "volumes": [
                            {
                              "name": "model-cache",
                              "persistentVolumeClaim": {
                                "claimName": "modelcache-ml-team-kimi-aa322"
                              }
                            }
                          ],
                          "schedulerName": "kai-scheduler",
                          "nodeSelector": {
                            "modelplane.ai/pool": "frontier"
                          },
                          "resourceClaims": [
                            {
                              "name": "devices",
                              "resourceClaimTemplateName": "r-main-worker-devices-99b8a"
                            }
                          ],
                          "tolerations": [
                            {
                              "key": "nvidia.com/gpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            },
                            {
                              "key": "amd.com/gpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            },
                            {
                              "key": "modelplane.ai/cpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "runtimeVersionOverride": "1.7.0"
                }
              ]
            }
          }
        }
      }
    }
  },
  "validation": null
}
