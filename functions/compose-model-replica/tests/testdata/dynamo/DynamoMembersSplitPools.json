{
  "name": "DynamoMembersSplitPools",
  "reason": "A Dynamo leader on the head pool and worker on the frontier pool each pin to their own pool.",
  "replica": {
    "apiVersion": "modelplane.ai/v1alpha1",
    "kind": "ModelReplica",
    "metadata": {
      "name": "r",
      "namespace": "ml-team"
    },
    "spec": {
      "clusterName": "cluster-a",
      "engines": [
        {
          "copies": 1,
          "members": [
            {
              "deviceRequests": [
                {
                  "count": 8,
                  "deviceClassName": "gpu.nvidia.com",
                  "name": "gpu",
                  "selectors": [
                    {
                      "cel": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                    }
                  ]
                }
              ],
              "nodePoolName": "head",
              "role": "Leader",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "command": [
                        "/bin/sh",
                        "-c",
                        "ray start --head --port=6379; exec python3 -m dynamo.vllm --model --model=meta-llama/Llama-3.1-405B --tensor-parallel-size=8 --pipeline-parallel-size=2 --port=8000"
                      ],
                      "image": "nvcr.io/nvidia/ai-dynamo/vllm-runtime-nightly:20261103-e37f0b9",
                      "name": "engine"
                    }
                  ]
                }
              }
            },
            {
              "deviceRequests": [
                {
                  "count": 8,
                  "deviceClassName": "gpu.nvidia.com",
                  "name": "gpu",
                  "selectors": [
                    {
                      "cel": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                    }
                  ]
                }
              ],
              "nodePoolName": "frontier",
              "role": "Worker",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "command": [
                        "/bin/sh",
                        "-c",
                        "exec ray start --address=$(MODELPLANE_LEADER_ADDRESS):6379 --block"
                      ],
                      "image": "nvcr.io/nvidia/ai-dynamo/vllm-runtime-nightly:20261103-e37f0b9",
                      "name": "engine"
                    }
                  ]
                }
              },
              "worker": {
                "nodes": 1
              }
            }
          ],
          "name": "main"
        }
      ]
    }
  },
  "provider_config": "cluster-a-pc",
  "want": {
    "resource-claim-main-leader": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "SuccessfulCreate"
        },
        "forProvider": {
          "manifest": {
            "apiVersion": "resource.k8s.io/v1",
            "kind": "ResourceClaimTemplate",
            "metadata": {
              "name": "r-main-leader-devices-f58c6",
              "namespace": "mp-ml-team-51733"
            },
            "spec": {
              "spec": {
                "devices": {
                  "requests": [
                    {
                      "name": "gpu",
                      "exactly": {
                        "deviceClassName": "gpu.nvidia.com",
                        "count": 8,
                        "selectors": [
                          {
                            "cel": {
                              "expression": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "resource-claim-main-worker": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "SuccessfulCreate"
        },
        "forProvider": {
          "manifest": {
            "apiVersion": "resource.k8s.io/v1",
            "kind": "ResourceClaimTemplate",
            "metadata": {
              "name": "r-main-worker-devices-99b8a",
              "namespace": "mp-ml-team-51733"
            },
            "spec": {
              "spec": {
                "devices": {
                  "requests": [
                    {
                      "name": "gpu",
                      "exactly": {
                        "deviceClassName": "gpu.nvidia.com",
                        "count": 8,
                        "selectors": [
                          {
                            "cel": {
                              "expression": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "workload-dynamo": {
      "spec": {
        "providerConfigRef": {
          "kind": "ClusterProviderConfig",
          "name": "cluster-a-pc"
        },
        "readiness": {
          "policy": "DeriveFromCelQuery",
          "celQuery": "has(object.status) && has(object.status.observedGeneration) && object.status.observedGeneration == object.metadata.generation && has(object.status.conditions) && object.status.conditions.exists(c, c.type == \"Ready\" && c.status == \"True\")"
        },
        "watch": true,
        "forProvider": {
          "manifest": {
            "apiVersion": "nvidia.com/v1beta1",
            "kind": "DynamoGraphDeployment",
            "metadata": {
              "name": "r",
              "namespace": "mp-ml-team-51733"
            },
            "spec": {
              "backendFramework": "vllm",
              "components": [
                {
                  "name": "frontend",
                  "type": "frontend",
                  "replicas": 1,
                  "podTemplate": {
                    "metadata": {
                      "labels": {
                        "modelplane.ai/serving": "r",
                        "modelplane.ai/replica": "r",
                        "modelplane.ai/deployment": "r"
                      }
                    },
                    "spec": {
                      "containers": [
                        {
                          "name": "main",
                          "image": "nvcr.io/nvidia/ai-dynamo/vllm-runtime-nightly:20261103-e37f0b9",
                          "command": [
                            "python3",
                            "-m",
                            "dynamo.frontend"
                          ],
                          "args": [
                            "--http-port",
                            "8000",
                            "--router-mode",
                            "kv"
                          ],
                          "env": [],
                          "volumeMounts": []
                        }
                      ],
                      "volumes": []
                    }
                  },
                  "runtimeVersionOverride": "1.7.0"
                },
                {
                  "name": "engine-main",
                  "type": "worker",
                  "replicas": 1,
                  "multinode": {
                    "nodeCount": 2
                  },
                  "roles": [
                    {
                      "name": "leader",
                      "replicas": 1,
                      "podTemplate": {
                        "metadata": {
                          "labels": {
                            "modelplane.ai/engine": "main",
                            "modelplane.ai/role": "Leader",
                            "kai.scheduler/queue": "modelplane"
                          }
                        },
                        "spec": {
                          "containers": [
                            {
                              "name": "main",
                              "image": "nvcr.io/nvidia/ai-dynamo/vllm-runtime-nightly:20261103-e37f0b9",
                              "volumeMounts": [],
                              "resources": {
                                "claims": [
                                  {
                                    "name": "devices"
                                  }
                                ]
                              },
                              "command": [
                                "/bin/sh",
                                "-c",
                                "ray start --head --port=6379; exec python3 -m dynamo.vllm --model --model=meta-llama/Llama-3.1-405B --tensor-parallel-size=8 --pipeline-parallel-size=2 --port=8000"
                              ],
                              "env": [
                                {
                                  "name": "MODELPLANE_LEADER_ADDRESS",
                                  "value": "$(DYNAMO_LEADER_ADDRESS)"
                                },
                                {
                                  "name": "MODELPLANE_RANK",
                                  "value": "$(DYNAMO_RANK)"
                                }
                              ]
                            }
                          ],
                          "volumes": [],
                          "schedulerName": "kai-scheduler",
                          "nodeSelector": {
                            "modelplane.ai/pool": "head"
                          },
                          "resourceClaims": [
                            {
                              "name": "devices",
                              "resourceClaimTemplateName": "r-main-leader-devices-f58c6"
                            }
                          ],
                          "tolerations": [
                            {
                              "key": "nvidia.com/gpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            },
                            {
                              "key": "amd.com/gpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            },
                            {
                              "key": "modelplane.ai/cpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "name": "worker",
                      "replicas": 1,
                      "podTemplate": {
                        "metadata": {
                          "labels": {
                            "modelplane.ai/engine": "main",
                            "modelplane.ai/role": "Worker",
                            "kai.scheduler/queue": "modelplane"
                          }
                        },
                        "spec": {
                          "containers": [
                            {
                              "name": "main",
                              "image": "nvcr.io/nvidia/ai-dynamo/vllm-runtime-nightly:20261103-e37f0b9",
                              "volumeMounts": [],
                              "resources": {
                                "claims": [
                                  {
                                    "name": "devices"
                                  }
                                ]
                              },
                              "command": [
                                "/bin/sh",
                                "-c",
                                "exec ray start --address=$(MODELPLANE_LEADER_ADDRESS):6379 --block"
                              ],
                              "env": [
                                {
                                  "name": "MODELPLANE_LEADER_ADDRESS",
                                  "value": "$(DYNAMO_LEADER_ADDRESS)"
                                },
                                {
                                  "name": "MODELPLANE_RANK",
                                  "value": "$(DYNAMO_RANK)"
                                }
                              ]
                            }
                          ],
                          "volumes": [],
                          "schedulerName": "kai-scheduler",
                          "nodeSelector": {
                            "modelplane.ai/pool": "frontier"
                          },
                          "resourceClaims": [
                            {
                              "name": "devices",
                              "resourceClaimTemplateName": "r-main-worker-devices-99b8a"
                            }
                          ],
                          "tolerations": [
                            {
                              "key": "nvidia.com/gpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            },
                            {
                              "key": "amd.com/gpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            },
                            {
                              "key": "modelplane.ai/cpu",
                              "operator": "Exists",
                              "effect": "NoSchedule"
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "runtimeVersionOverride": "1.7.0"
                }
              ]
            }
          }
        }
      }
    }
  },
  "validation": null
}
