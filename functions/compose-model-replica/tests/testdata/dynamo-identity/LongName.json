          "copies": 3,
          "members": [
            {
              "role": "Standalone",
              "nodePoolName": "frontier",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "name": "engine",
                      "image": "vllm/vllm-openai:v0.32.0",
                      "command": [
                        "vllm",
                        "serve"
