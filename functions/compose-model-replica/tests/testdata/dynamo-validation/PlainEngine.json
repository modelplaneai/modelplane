{
  "name": "PlainEngine",
  "reason": "Reject an incompatible Dynamo graph with a concrete correction.",
  "replica": {
    "apiVersion": "modelplane.ai/v1alpha1",
    "kind": "ModelReplica",
    "metadata": {
      "name": "r",
      "namespace": "ml-team"
    },
    "spec": {
      "clusterName": "cluster-a",
      "engines": [
        {
          "name": "prefill",
          "copies": 1,
          "members": [
            {
              "role": "Standalone",
              "nodePoolName": "frontier",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "name": "engine",
                      "image": "vllm/vllm-openai:v0.23.0",
                      "command": [
                        "vllm",
                        "serve"
                      ],
                      "args": [
                        "--model",
                        "Qwen/Qwen3-0.6B",
                        "--disaggregation-mode",
                        "prefill",
                        "--kv-transfer-config",
                        "{\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\"}"
                      ]
                    },
                    {
                      "name": "logging",
                      "image": "example/logger:1",
                      "args": [
                        "--stdout"
                      ]
                    }
                  ]
                }
              },
              "deviceRequests": [
                {
                  "name": "gpu",
                  "deviceClassName": "gpu.nvidia.com",
                  "count": 1
                }
              ]
            }
          ],
          "phase": "Prefill"
        },
        {
          "name": "decode",
          "copies": 2,
          "members": [
            {
              "role": "Standalone",
              "nodePoolName": "frontier",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "name": "engine",
                      "image": "nvcr.io/nvidia/ai-dynamo/vllm-runtime-nightly:20261103-e37f0b9",
                      "command": [
                        "python3",
                        "-m",
                        "dynamo.vllm"
                      ],
                      "args": [
                        "--model",
                        "Qwen/Qwen3-0.6B",
                        "--disaggregation-mode",
                        "decode",
                        "--kv-transfer-config",
                        "{\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\"}"
                      ]
                    },
                    {
                      "name": "logging",
                      "image": "example/logger:1",
                      "args": [
                        "--stdout"
                      ]
                    }
                  ]
                }
              },
              "deviceRequests": [
                {
                  "name": "gpu",
                  "deviceClassName": "gpu.nvidia.com",
                  "count": 1
                }
              ]
            }
          ],
          "phase": "Decode"
        }
      ],
      "serving": {
        "mode": "PrefillDecode"
      }
    }
  },
  "want": "Dynamo engines must use a runtime image and launch dynamo.vllm, dynamo.sglang, or dynamo.trtllm"
}
