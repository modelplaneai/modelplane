{
  "name": "NoLaunch",
  "reason": "A runtime image alone cannot infer the model and launch arguments.",
  "replica": {
    "apiVersion": "modelplane.ai/v1alpha1",
    "kind": "ModelReplica",
    "metadata": {
      "name": "r",
      "namespace": "ml-team"
    },
    "spec": {
      "clusterName": "cluster-a",
      "engines": [
        {
          "name": "main",
          "copies": 3,
          "members": [
            {
              "role": "Standalone",
              "nodePoolName": "frontier",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "name": "engine",
                      "image": "nvcr.io/nvidia/ai-dynamo/vllm-runtime-nightly:20261103-e37f0b9"
                    },
                    {
                      "name": "logging",
                      "image": "example/logger:1",
                      "args": [
                        "--stdout"
                      ]
                    }
                  ]
                }
              },
              "deviceRequests": [
                {
                  "name": "gpu",
                  "deviceClassName": "gpu.nvidia.com",
                  "count": 1
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "want": "Dynamo member main/standalone requires a command or runtime args"
}
