{
  "name": "MismatchedRuntimeVersions",
  "reason": "A component-wide nightly override must not misdeclare another role's runtime version.",
  "replica": {
    "apiVersion": "modelplane.ai/v1alpha1",
    "kind": "ModelReplica",
    "metadata": {
      "name": "r",
      "namespace": "ml-team"
    },
    "spec": {
      "clusterName": "cluster-a",
      "engines": [
        {
          "copies": 1,
          "members": [
            {
              "deviceRequests": [
                {
                  "count": 8,
                  "deviceClassName": "gpu.nvidia.com",
                  "name": "gpu",
                  "selectors": [
                    {
                      "cel": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                    }
                  ]
                }
              ],
              "nodePoolName": "frontier",
              "role": "Leader",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "command": [
                        "/bin/sh",
                        "-c",
                        "ray start --head --port=6379; exec python3 -m dynamo.vllm --model --model=meta-llama/Llama-3.1-405B --tensor-parallel-size=8 --pipeline-parallel-size=2 --port=8000"
                      ],
                      "image": "registry.example.com/team/dynamo-vllm:1.6.1",
                      "name": "engine"
                    }
                  ]
                }
              }
            },
            {
              "deviceRequests": [
                {
                  "count": 8,
                  "deviceClassName": "gpu.nvidia.com",
                  "name": "gpu",
                  "selectors": [
                    {
                      "cel": "device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"80Gi\")) >= 0"
                    }
                  ]
                }
              ],
              "nodePoolName": "frontier",
              "role": "Worker",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "command": [
                        "/bin/sh",
                        "-c",
                        "exec ray start --address=$(MODELPLANE_LEADER_ADDRESS):6379 --block"
                      ],
                      "image": "nvcr.io/nvidia/ai-dynamo/vllm-runtime-nightly:20261103-e37f0b9",
                      "name": "engine"
                    }
                  ]
                }
              },
              "worker": {
                "nodes": 1
              }
            }
          ],
          "name": "main"
        }
      ]
    }
  },
  "want": "Nightly component members must use the pinned nightly or semantic runtime version 1.7.0"
}
