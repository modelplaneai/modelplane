{
  "name": "EndpointPicker",
  "reason": "Reject EndpointPicker before applying a Dynamo graph.",
  "replica": {
    "apiVersion": "modelplane.ai/v1alpha1",
    "kind": "ModelReplica",
    "metadata": {
      "name": "r",
      "namespace": "ml-team"
    },
    "spec": {
      "clusterName": "cluster-a",
      "engines": [
        {
          "name": "prefill",
          "copies": 1,
          "members": [
            {
              "role": "Standalone",
              "nodePoolName": "frontier",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "name": "engine",
                      "image": "vllm/vllm-openai:v0.32.0",
                      "command": [
                        "vllm",
                        "serve"
                      ],
                      "args": [
                        "--model",
                        "Qwen/Qwen3-0.6B",
                        "--disaggregation-mode",
                        "prefill",
                        "--kv-transfer-config",
                        "{\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\"}"
                      ],
                      "readinessProbe": {
                        "grpc": {
                          "port": 30001
                        },
                        "periodSeconds": 5
                      }
                    },
                    {
                      "name": "logging",
                      "image": "example/logger:1",
                      "args": [
                        "--stdout"
                      ]
                    }
                  ],
                  "initContainers": [
                    {
                      "name": "runtime",
                      "image": "example/dynamo-sidecar:1.7.0",
                      "command": [
                        "dynamo-vllm-sidecar"
                      ],
                      "args": [
                        "--grpc-endpoint",
                        "127.0.0.1:30001"
                      ],
                      "restartPolicy": "Always"
                    }
                  ]
                }
              },
              "deviceRequests": [
                {
                  "name": "gpu",
                  "deviceClassName": "gpu.nvidia.com",
                  "count": 1
                }
              ]
            }
          ],
          "phase": "Prefill"
        },
        {
          "name": "decode",
          "copies": 2,
          "members": [
            {
              "role": "Standalone",
              "nodePoolName": "frontier",
              "template": {
                "spec": {
                  "containers": [
                    {
                      "name": "engine",
                      "image": "vllm/vllm-openai:v0.32.0",
                      "command": [
                        "vllm",
                        "serve"
                      ],
                      "args": [
                        "--model",
                        "Qwen/Qwen3-0.6B",
                        "--disaggregation-mode",
                        "decode",
                        "--kv-transfer-config",
                        "{\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\"}"
                      ],
                      "readinessProbe": {
                        "grpc": {
                          "port": 30001
                        },
                        "periodSeconds": 5
                      }
                    },
                    {
                      "name": "logging",
                      "image": "example/logger:1",
                      "args": [
                        "--stdout"
                      ]
                    }
                  ],
                  "initContainers": [
                    {
                      "name": "runtime",
                      "image": "example/dynamo-sidecar:1.7.0",
                      "command": [
                        "dynamo-vllm-sidecar"
                      ],
                      "args": [
                        "--grpc-endpoint",
                        "127.0.0.1:30001"
                      ],
                      "restartPolicy": "Always"
                    }
                  ]
                }
              },
              "deviceRequests": [
                {
                  "name": "gpu",
                  "deviceClassName": "gpu.nvidia.com",
                  "count": 1
                }
              ]
            }
          ],
          "phase": "Decode"
        }
      ],
      "serving": {
        "mode": "Unified",
        "router": "EndpointPicker"
      }
    }
  },
  "want": "Dynamo clusters require serving.router: Dynamo and serving.dynamo.frontend"
}
